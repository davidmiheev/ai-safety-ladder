{
  "mcpServers": {
    "colab": {
      "command": "external/ds-agent/src/colab_mcp/.venv/bin/python",
      "args": ["-m", "colab_mcp.colab_server"],
      "env": {
        "PYTHONPATH": "external/ds-agent/src"
      }
    },
    "kaggle": {
      "command": "external/kaggle-mcp-venv/bin/python",
      "args": ["scripts/kaggle_mcp.py"],
      "env": {
        "PYTHONPATH": "external/ds-agent/src",
        "KAGGLE_MCP_TOKEN": "${KAGGLE_API_TOKEN:-}"
      }
    }
  }
}
